{
  "name": "owen-alice-adventure",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Owen & Alice's Adventure: a kids' educational auto-running platformer for phones and tablets.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . && tsc --noEmit -p tsconfig.json",
    "check": "npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
